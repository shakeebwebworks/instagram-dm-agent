# Add these in Render -> Environment (never commit real values)

# Any random text you choose. You type the same text in Meta's webhook setup.
VERIFY_TOKEN=choose_any_random_text

# Meta Developer app -> Settings -> Basic -> App Secret
APP_SECRET=

# Instagram access token for your Business account (from Meta app -> Instagram API setup)
IG_ACCESS_TOKEN=

# From console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: instant lead alerts on Telegram (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides
# MODEL=claude-sonnet-5-5
# GRAPH_VERSION=v21.0
